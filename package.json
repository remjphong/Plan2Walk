{
  "name": "plan2walk",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w @plan2walk/api\" \"npm run dev -w @plan2walk/web\"",
    "check": "tsc --noEmit",
    "test": "tsx --test packages/floorplan/test/*.test.ts apps/api/test/*.test.ts",
    "build": "npm run build -w @plan2walk/web && npm run build -w @plan2walk/api",
    "start": "node apps/api/dist/main.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
