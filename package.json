{
  "name": "plan2walk-rush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plan2Walk MVP - AI-assisted floorplan to deterministic 3D",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dataset:inventory": "python3 scripts/dataset_inventory.py",
    "evaluate": "node --import tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}